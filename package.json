{
  "name": "projectpulse",
  "version": "0.1.0",
  "private": true,
  "description": "ProjectPulse: Academic Project Governance, Originality and Milestone Risk Monitor",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:seed": "tsx scripts/seed.ts",
    "mongo:init": "tsx scripts/mongo-init.ts",
    "mongo:seed-hosted": "tsx scripts/seed-hosted-mongo.ts",
    "embed:backfill": "tsx scripts/embed-backfill.ts",
    "risk:sweep": "tsx scripts/risk-sweep.ts",
    "test": "vitest run",
    "docs:data-dictionary": "tsx scripts/data-dictionary.ts",
    "mongo:reconcile": "tsx scripts/mongo-reconcile.ts",
    "docs:explain": "tsx scripts/explain-evidence.ts",
    "docs:screenshots": "tsx scripts/capture-docs.ts",
    "test:report": "ALLOW_MUTATING_TESTS=1 vitest run --reporter=default --reporter=json --outputFile.json=docs/.vitest-results.json && tsx scripts/test-report.ts docs/.vitest-results.json && rm -f docs/.vitest-results.json",
    "docs:report": "tsx scripts/build-report.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "mongodb": "^6.10.0",
    "next": "^15.1.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "cli-progress": "^3.12.0",
    "dotenv": "^16.4.7",
    "marked": "^15.0.4",
    "mermaid": "^11.4.1",
    "playwright-core": "^1.49.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
