# PostgreSQL (app connects as least-privilege role pp_app; migrations use the owner URL)
DATABASE_URL=postgresql://pp_app:APP_DB_PASSWORD@localhost:5432/projectpulse
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/projectpulse
APP_DB_PASSWORD=choose-a-password-for-pp_app
DB_SEARCH_PATH=projectpulse,public
# MongoDB
MONGODB_URI=mongodb://localhost:27017/projectpulse
MONGODB_DB=projectpulse
# Auth
AUTH_SECRET=generate-a-long-random-string
SESSION_MAX_AGE_HOURS=8
# Storage (mongodb-gridfs persists uploads on Atlas for Render's free web service)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_MAX_FILE_MB=10
# On Vercel set STORAGE_DRIVER=vercel-blob, STORAGE_MAX_FILE_MB=4, and BLOB_READ_WRITE_TOKEN in the project settings.
# Vercel Functions accept at most 4.5 MB per request or response, including multipart form overhead.
# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
SIMILARITY_THRESHOLD=0.80
SIMILARITY_TOP_K=5
# Jobs and seeding
JOB_SECRET=another-random-string
SEED_DEFAULT_PASSWORD=choose-a-demo-password
# Set SKIP_DATABASE_CREATE=1 when using an already-created managed PostgreSQL database.
# Test only: lets the API tests force a failure inside the milestone submission (never honoured in production)
# ENABLE_TEST_HOOKS=1
